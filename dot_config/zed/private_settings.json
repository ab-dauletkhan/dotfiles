// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "git": {
    "gutter_debounce": 100
  },
  "calls": {
    "mute_on_join": true
  },
  "agent": {
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "disable_ai": true,
  "proxy": "",
  "active_pane_modifiers": {
    "border_size": 1,
    "inactive_opacity": 0.5,
  },
  "bottom_dock_layout": "contained",
  "redact_private_values": false,
  "when_closing_with_no_tabs": "platform_default",
  "diff_view_style": "unified",
  "git_panel": {
    "tree_view": true,
  },
  "buffer_font_family": "Monaspace Neon Var",
  "buffer_font_fallbacks": ["Symbols Nerd Font"],
  "buffer_font_size": 14,
  "icon_theme": "Catppuccin Latte",
  "ui_font_size": 14,
  "ui_font_family": "Monaspace Neon Var",
  "ui_font_weight": 400,
  "theme": {
    "mode": "dark",
    "light": "Everforest Light Hard (regular)",
    "dark": "Everforest Dark Hard (blur)",
  },
  "terminal": {
    "shell": "system",
    "font_size": 13.0,
    "working_directory": "current_project_directory",
    "detect_venv": {
      "on": {
        "directories": [".venv"],
        "activate_script": "default",
      },
    },
  },
  "languages": {
    "Python": {
      "language_servers": ["basedpyright", "ruff", "..."],
      "formatter": {
        "language_server": { "name": "ruff" },
      },
      "format_on_save": "off",
    },
  },
  "lsp": {
    "basedpyright": {
      "settings": {
        "basedpyright.analysis": {
          "diagnosticMode": "openFilesOnly",
          "inlayHints": {
            "variableTypes": true,
            "functionReturnTypes": true,
          },
        },
      },
    },
  },
}
