#!/usr/bin/env bash

export CONFIG_DIR="${CONFIG_DIR:-$HOME/.config/sketchybar}"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/settings.sh"
source "$CONFIG_DIR/icons.sh"
source "$CONFIG_DIR/helpers.sh"

# Reset
sketchybar --remove '/.*/'

# Global bar: transparent / glassy, no black slab
sketchybar --bar \
  position=top \
  height="$BAR_HEIGHT" \
  color="$TRANSPARENT" \
  blur_radius=30 \
  margin=4 \
  corner_radius=0 \
  padding_left=10 \
  padding_right=10 \
  sticky=on \
  topmost=window \
  shadow=off

# Defaults for all items
sketchybar --default \
  updates=on \
  drawing=on \
  padding_left="$ITEM_PADDING_LEFT" \
  padding_right="$ITEM_PADDING_RIGHT" \
  icon.font="$ICON_FONT" \
  icon.color="$FG" \
  icon.padding_left="$ICON_PADDING_LEFT" \
  icon.padding_right="$ICON_PADDING_RIGHT" \
  label.font="$FONT" \
  label.color="$FG" \
  label.padding_left="$LABEL_PADDING_LEFT" \
  label.padding_right="$LABEL_PADDING_RIGHT" \
  background.drawing=on \
  background.color="$CAPSULE_BG" \
  background.border_color="$CAPSULE_BORDER" \
  background.border_width="$BORDER_WIDTH" \
  background.height="$ITEM_HEIGHT" \
  background.corner_radius="$CAPSULE_RADIUS"

# Items
source "$ITEM_DIR/workspace.sh"

source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/input_source.sh"

"$PLUGIN_DIR/omniwm_watch.sh" >/dev/null 2>&1 &

# Initial update
sketchybar --update
